# Copy to .env next to docker-compose.yml and fill in.

# Used to create the admin login on first start. Change it later in the web UI.
SAVEPOINT_ADMIN_PASSWORD=change-me-please

# Set to true (with a new SAVEPOINT_ADMIN_PASSWORD) and restart to reset a
# forgotten password. Set it back to false afterwards.
SAVEPOINT_RESET_ADMIN_PASSWORD=false

# Optional: signs session cookies. If unset, a random key is generated and
# stored in data/secret_key.
# SAVEPOINT_SECRET_KEY=

# Nightly job times (HH:MM, in TZ).
# SAVEPOINT_RETENTION_TIME=03:30
# SAVEPOINT_OFFSITE_TIME=04:15

# Only for plain-HTTP testing without the proxy: cookies are HTTPS-only by default.
# SAVEPOINT_SECURE_COOKIES=false
